# MindScape configuration. Every value has a working default — copy to .env only
# if you want to override something.

# --- Acquisition -------------------------------------------------------------
MINDSCAPE_SAMPLE_RATE=256
MINDSCAPE_WINDOW_SECONDS=2.0
MINDSCAPE_WINDOW_OVERLAP=0.5
# 50 in most of the world, 60 in the Americas
MINDSCAPE_LINE_FREQUENCY=60

# --- Sessions ----------------------------------------------------------------
MINDSCAPE_DEFAULT_DURATION=120
MINDSCAPE_MAX_UPLOAD_BYTES=67108864

# --- Optional LLM narrative generation ---------------------------------------
# Any OpenAI-compatible endpoint. Leave unset to use the deterministic local
# narrative engine — the product is fully functional without a model.
# MINDSCAPE_LLM_BASE_URL=https://api.openai.com/v1
# MINDSCAPE_LLM_API_KEY=
# MINDSCAPE_LLM_MODEL=gpt-4o-mini

# --- CORS --------------------------------------------------------------------
MINDSCAPE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
