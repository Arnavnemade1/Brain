# MindScape configuration. Every value has a working default — copy to .env only
# if you want to override something.

# --- Acquisition -------------------------------------------------------------
MINDSCAPE_SAMPLE_RATE=256
MINDSCAPE_WINDOW_SECONDS=2.0
MINDSCAPE_WINDOW_OVERLAP=0.5
# 50 in most of the world, 60 in the Americas
MINDSCAPE_LINE_FREQUENCY=60

# --- Sessions ----------------------------------------------------------------
MINDSCAPE_MAX_SESSIONS=24
# MINDSCAPE_DATA_DIR=./backend/.data

# --- CORS --------------------------------------------------------------------
MINDSCAPE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
